{
  "description": "Chrome Trace format single complete event.\n\nts/dur unit: microseconds, origin=0 corresponds to frame start.\nextra=\"ignore\" to accept future C++ / Perfetto extension fields (args/pid).",
  "properties": {
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "ts": {
      "minimum": 0,
      "title": "Ts",
      "type": "number"
    },
    "dur": {
      "minimum": 0,
      "title": "Dur",
      "type": "number"
    },
    "tid": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Tid",
      "type": "string"
    },
    "ph": {
      "const": "X",
      "title": "Ph",
      "type": "string"
    },
    "cat": {
      "default": "",
      "maxLength": 64,
      "title": "Cat",
      "type": "string"
    }
  },
  "required": [
    "name",
    "ts",
    "dur",
    "tid",
    "ph"
  ],
  "title": "TraceEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision.example.com/schema/traceevent.v1.3.schema.json"
}
